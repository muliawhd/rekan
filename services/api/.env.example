APP_NAME=Re
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=rekan_local
DB_USERNAME=rekan_local
DB_PASSWORD=
# Local Docker PostgreSQL holds all application domain data.
DB_SSLMODE=prefer
SESSION_DRIVER=array
CACHE_STORE=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=null
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
# Supabase Cloud Auth only. No JWT middleware is implemented in Phase 2A.
# URL: https://<project-ref>.supabase.co (confirm project environment separately).
SUPABASE_URL=
# Exact URL + /auth/v1; no trailing slash.
SUPABASE_JWT_ISSUER=
# Exact URL + /auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional absolute path to a trusted CA bundle; empty uses PHP/system trust.
SUPABASE_CA_BUNDLE=
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only credentials; NOT required for JWKS verification.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=materials-private
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
